import cv2 as cv
import numpy as np
import sys


s = 0

if len(sys.argv) > 1:

    s = sys.argv[1]

face_cam = cv.VideoCapture(s)

net = cv.dnn.readNetFromCaffe(r"D:\OpenCV\deploy.prototxt",r"D:\OpenCV\res10_300x300_ssd_iter_140000_fp16.caffemodel")

used_width = 300
used_height = 300
used_mean = [104,117,123]
conf_threshold = 0.5

while cv.waitKey(1) != 27:

    ret,frame = face_cam.read()

    frame_width = frame.shape[1]
    frame_height = frame.shape[0]

    blob = cv.dnn.blobFromImage(frame,1.0,(used_width,used_height),used_mean,False,False)

    net.setInput(blob)

    directions = net.forward()

    for i in range(directions.shape[2]):

        confidence = directions[0,0,i,2]
        if confidence  > conf_threshold:
            x_left_bottom = int(directions[0,0,i,3] * frame_width)
            y_left_bottom = int(directions[0,0,i,4] * frame_height)
            x_right_top = int(directions[0,0,i,5] * frame_width)
            y_right_top = int(directions[0,0,i,6] * frame_height)

            # cv.rectangle(frame,(x_right_top,y_right_top),(x_left_bottom,y_left_bottom),(0,200,0),2)
            cv.rectangle(frame,(x_right_top,y_right_top),(x_left_bottom,y_left_bottom),(0,0,0),-1)

            label = "Confidence level: {:.3}".format(confidence)
            
            cv.putText(frame,label,(x_left_bottom,y_left_bottom),cv.FONT_HERSHEY_SIMPLEX,0.5,(0,0,0),2)

    t, not_needed = net.getPerfProfile()
    label = "Network time: {:0}".format(t * 1000 / cv.getTickFrequency())
    # cv.putText(frame,label,(x_left_bottom ,y_left_bottom + 30),cv.FONT_HERSHEY_PLAIN,1,(0,200,0),2)
    cv.imshow("FaceCam",frame)


